{
  "name": "buddy-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.container.config.ts",
    "typecheck": "tsc --noEmit",
    "save-office-pages": "node scripts/save-office-pages.ts",
    "smoke": "node scripts/smoke-claude.ts",
    "smoke:guidebook": "node scripts/smoke-guidebook.ts",
    "smoke:handoff": "node scripts/smoke-handoff.ts",
    "smoke:milestones": "node scripts/smoke-milestones.ts",
    "smoke:roadmap": "node scripts/smoke-roadmap.ts",
    "save-bulletin-pages": "node scripts/save-bulletin-pages.ts",
    "check-login": "node scripts/check-login.ts",
    "forget-login": "node scripts/forget-login.ts",
    "check-canvas": "node --disable-warning=ExperimentalWarning scripts/check-canvas.ts",
    "check-tuportal": "node --disable-warning=ExperimentalWarning scripts/check-tuportal.ts",
    "pair": "node --disable-warning=ExperimentalWarning scripts/pair.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "fastify": "5.12.7",
    "ical.js": "2.2.1",
    "parse5": "8.1.0",
    "playwright-core": "1.64.1",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
